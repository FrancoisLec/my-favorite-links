{
  "manifest_version": 3,
  "name": "My Favorite Links",
  "version": "1.0.1",
  "description": "Save, organize, tag and search your favorite links.",
  "author": "Francois Lecompte",
  "homepage_url": "https://github.com/FrancoisLec/my-favorite-links",
  "permissions": ["storage", "activeTab", "contextMenus", "favicon"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "My Favorite Links (Ctrl+Shift+Y)",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "manager.html",
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" }
    }
  }
}
